#!/bin/sh
#
# OUTPUT FILES
#	conf/CXX               Compiler
#	conf/CXXFLAGS          Flags used for all compilations
#	conf/CXXFLAGS_RELEASE  Flags for bin/stu
#
# ENVIRONMENT
#	$CXX                   (optional)
#	$CXXFLAGS              (optional)
#	$CONFIGURE_VERBOSE     (optional)
#

filename=${TMPDIR:-/tmp}/stu.conf.$$
source=$filename.cc
source2=$filename.2.cc
target=$filename.out
compiler_stderr=$filename.stderr
[ "$CONFIGURE_VERBOSE" ] && exec 3>&2 || exec 3>/dev/null

Check()
# $1...   Options to test
{
	name="$*"
	name=${name:-$CXX}
	rm -f "$target" || exit 1
	[ "$CXX" ] || { printf '$CXX must be set\n' ; exit 1 ; }
	$CXX $CXXFLAGS "$@" "$source" -o "$target" 2>"$compiler_stderr" || {
		printf " %s(no)" "$name"
		echo >&3 "*** Compiler failed:"
		cat  >&3 "$compiler_stderr"
		return 1
	}
	cat >&3 "$compiler_stderr"
	grep -q -E -i -e '(error|warning)' "$compiler_stderr" && {
		printf " %s(no)" "$name"
		echo >&3 "*** Compiler printed an error or warning:"
		cat  >&3 "$compiler_stderr"
		return 1
	}

	"$target" || {
		printf " %s(no)" "$name"
		echo >&3 "*** Test program failed"
		return 1
	}
	printf " %s" "$name"
	return 0
}

Check_Code()
# $1   Name
# $2   Code
{
	rm -f "$target" "$source2" || exit 1
	{ cat "$source" ; printf '%s' "$2" ; } >"$source2"
	$CXX $CXXFLAGS "$source2" -o "$target" 2>"$compiler_stderr" || {
		printf " %s(no)" "$1"
		echo >&3 "compiler failed"
		return 1
	}
	grep -q -E -i -e '(error|warning)' "$compiler_stderr" && {
		printf " %s(no)" "$1"
		echo >&3 "*** Compiler printed an error or warning:"
		cat  >&3 "$compiler_stderr"
		return 1
	}
	"$target" || {
		printf " %s(no)" "$1"
		echo >&3 "*** Test program failed"
		return 1
	}
	printf " %s" "$1"
	return 0
}

Clean()
{
	[ "$source" ] && rm -f -- "$filename".*
}
trap Clean EXIT INT QUIT TERM ABRT HUP

echo >&3 source="$filename".cc
echo >&3 source2="$filename".2.cc
echo >&3 target="$filename".out
echo >&3 compiler_stderr="$filename".stderr

printf "Checking compiler..."

cat >"$source" <<EOF || exit 1
struct Alpha { int x; Alpha(int a):  x(2 - a) { } };
int main() { Alpha alpha(2); return alpha.x; }
EOF

if [ "$CXX" ] ; then
	if ! Check ; then
		echo
		echo >&2 "*** $0: \$CXX ($CXX) does not work"
		exit 1
	fi
else
	found=
	for CXX in g++ c++ clang++ gpp cxx ; do
		if Check ; then found=1 ; break ; fi
	done

	if [ -z "$found" ] ; then
		echo
		echo >&2 "*** $0: No compiler found"
		exit 1
	fi
fi

for option in -std=c++17 ; do
	if Check $option ; then
		CXXFLAGS="${CXXFLAGS:+$CXXFLAGS }$option"
	fi
done

Check_Code CLOCK_REALTIME_COARSE '
#include <time.h>
void x() { struct timespec t; int r= clock_gettime(CLOCK_REALTIME_COARSE, &t); }
'
CXXFLAGS="${CXXFLAGS:+$CXXFLAGS }-DHAVE_CLOCK_REALTIME_COARSE=$(echo $? | tr 01 10)"

CXXFLAGS_RELEASE=-DNDEBUG
for option in -O2 -fwhole-program -s -w ; do
	if Check $option ; then
		CXXFLAGS_RELEASE="${CXXFLAGS_RELEASE:+$CXXFLAGS_RELEASE }$option"
	fi
done

echo

mkdir -p conf || exit 1
printf '%s\n' "$CXX"              >conf/CXX              || exit 1
printf '%s\n' "$CXXFLAGS"         >conf/CXXFLAGS         || exit 1
printf '%s\n' "$CXXFLAGS_RELEASE" >conf/CXXFLAGS_RELEASE || exit 1
