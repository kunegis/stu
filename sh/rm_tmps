#!/bin/sh
#
# Remove temporary files created by tests.  The tests only create temporary files of these
# patterns.  Executed within each test directory.  Any such named files may be
# directories.
#
# None of the patterns matches any file that we would create within the main stu/
# directory, so we can safely call this to remove junk files created while debugging.  In
# particular, all one-letter and two-letter files are deleted except 'sh'.
#
# Kept in sync with .gitignore.
#
# INVOCATION
#    $0 [--not-sh] [DIR]...
#
# OPTIONS
#    --not-sh   Don't delete 'sh' (only used for main directory of Stu repo)
#

SCRIPT=$0

# Due to use of rm unquoted $@ and xargs, patterns must not contain any of the characters
# in the set { ' " \ }.  Characters * and ? can only be used as glob patterns.
patterns='
?
??
list.*
A.*
*.data
x.*
*SCHTROUMPF*
.+-~_
*abcdef
'

if [ "$1" = --not-sh ] ; then
	shift
	[ $# != 0 ] && { echo >&2 "Option --not-sh cannot be used with explicit directories" ; exit 1 ; }
	rm -Rf -f ? list.* A.* *.data x.* *SCHTROUMPF* .+-~_ *abcdef || exit 1
	for file in ?? ; do
		[ "$file" = sh ] && continue
		rm -R -f -- "$file" || exit 1
	done
	exit
fi

if [ "$1" = --delete ] ; then
	shift
	rm -R -f -- $@
	exit
fi

Remove_Files() # [DIR]...
{
	printf '%s\n' "$@" |
	while IFS= read -r dir ; do
		printf '%s' "$patterns" | while IFS= read -r pattern ; do
			[ "$pattern" ] || continue
			printf '%s/%s\0' "$dir" "$pattern"
		done
	done |
	xargs -0 "$SCRIPT" --delete
}

if [ $# = 0 ] ; then
	Remove_Files .
else
	Remove_Files "$@"
fi
