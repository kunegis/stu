# TOPIC: %set many environment variables with long names that only differ in the end

%set STU_TEST_AAA_BBB_CCC_DDD_EEE_FFF_GGG_HHH_1 aaa
%set STU_TEST_AAA_BBB_CCC_DDD_EEE_FFF_GGG_HHH_2 bbb
%set STU_TEST_AAA_BBB_CCC_DDD_EEE_FFF_GGG_HHH_3 ccc
%set STU_TEST_AAA_BBB_CCC_DDD_EEE_FFF_GGG_HHH_4 ddd
%set STU_TEST_AAA_BBB_CCC_DDD_EEE_FFF_GGG_HHH_5 eee
%set STU_TEST_AAA_BBB_CCC_DDD_EEE_FFF_GGG_HHH_6 fff
%set STU_TEST_AAA_BBB_CCC_DDD_EEE_FFF_GGG_HHH_7 ggg
%set STU_TEST_AAA_BBB_CCC_DDD_EEE_FFF_GGG_HHH_8 hhh
%set STU_TEST_AAA_BBB_CCC_DDD_EEE_FFF_GGG_HHH_9 iii

>A
{
	[ "$STU_TEST_AAA_BBB_CCC_DDD_EEE_FFF_GGG_HHH_1" = aaa ]
	[ "$STU_TEST_AAA_BBB_CCC_DDD_EEE_FFF_GGG_HHH_2" = bbb ]
	[ "$STU_TEST_AAA_BBB_CCC_DDD_EEE_FFF_GGG_HHH_3" = ccc ]
	[ "$STU_TEST_AAA_BBB_CCC_DDD_EEE_FFF_GGG_HHH_4" = ddd ]
	[ "$STU_TEST_AAA_BBB_CCC_DDD_EEE_FFF_GGG_HHH_5" = eee ]
	[ "$STU_TEST_AAA_BBB_CCC_DDD_EEE_FFF_GGG_HHH_6" = fff ]
	[ "$STU_TEST_AAA_BBB_CCC_DDD_EEE_FFF_GGG_HHH_7" = ggg ]
	[ "$STU_TEST_AAA_BBB_CCC_DDD_EEE_FFF_GGG_HHH_8" = hhh ]
	[ "$STU_TEST_AAA_BBB_CCC_DDD_EEE_FFF_GGG_HHH_9" = iii ]
}
